# Neon Postgres (Vercel Marketplace integration supplies these automatically)
# Use the pooled URL for the Next.js app and sync jobs.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Use the direct URL for Drizzle migrations when available.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Robinhood Chain
NEXT_PUBLIC_CHAIN_ID="4663"
NEXT_PUBLIC_EXPLORER_URL="https://robinhoodchain.blockscout.com"
ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ROBINHOOD_ASSETS_API_URL="https://api.robinhood.com/rhj/assets"
ROBINHOOD_API_BASE_URL="https://api.robinhood.com"
BLOCKSCOUT_API_BASE_URL="https://robinhoodchain.blockscout.com/api/v2"
# BLOCKSCOUT_API_KEY=""

# Bounded public-data collection limits
TRANSFER_SYNC_BATCH_SIZE="24"
TRANSFER_SYNC_HOT_TOKENS="6"
TRANSFER_SYNC_MAX_PAGES="2"
TRANSFER_SYNC_LOOKBACK_HOURS="48"
METADATA_SYNC_BATCH_SIZE="50"

# Demo-only. Keep unset/false in production so synthetic SWAP actions are not generated.
# ALLOW_SYNTHETIC_ACTIONS="false"

# Protected server-side operations
CRON_SECRET="replace-with-a-long-random-secret"
ADMIN_SYNC_SECRET="replace-with-a-different-long-random-secret"

# Optional Vercel Blob snapshot fallback
# BLOB_READ_WRITE_TOKEN=""
# SNAPSHOT_URL_V3=""

# Optional one-time migration source
# SQLITE_SOURCE_PATH="data/robin.db"
